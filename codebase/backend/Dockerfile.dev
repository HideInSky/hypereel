# Dev image used by docker-compose: source is bind-mounted, tsx watches it.
FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
COPY codebase/backend/package.json codebase/backend/
COPY codebase/frontend/package.json codebase/frontend/
RUN npm ci
WORKDIR /app/codebase/backend
CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma generate && npm run dev"]
