// Prisma schema: the single source of truth for the database shape.
// Every change here becomes a versioned SQL migration in prisma/migrations
// (`npm run migrate:dev -- --name <what-changed>`), which is what runs in prod.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationStatus {
  queued
  running
  succeeded
  failed
}

// One row per "Hypereel" request. The uploaded photo and the resulting
// video live in object storage (local volume for now); the DB only keeps paths.
model Generation {
  id          String           @id @default(cuid())
  status      GenerationStatus @default(queued)
  genre       String
  /// Name of a custom effect at render time (built-in names come from effects.ts)
  effectName  String?
  /// Set when this clip is a shot in a story: "continue" or "restage"
  shotMode    String?
  sequenceId  String?
  /// Set when the clip was made on a canvas
  canvasId    String?
  caption     String?
  prompt      String
  /// Scene written by the script-writer LLM node (null for static-template clips)
  script      String?
  /// Uploaded references in the order sent to the model: [{ role, path }]
  references  Json?
  resolution  String?
  aspectRatio String?
  model       String           // which H3 variant produced it, for the credits math
  comfyJobId  String?
  progress    Int              @default(0)   // 0-100, best effort from Comfy events
  inputPath   String                         // uploaded (resized) photo
  videoPath   String?
  posterPath  String?
  error       String?
  sessionId   String                         // anonymous cookie session
  ip          String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([sessionId, createdAt])
  @@index([ip, createdAt])
  @@index([status, createdAt])
}

/// An effect someone wrote or remixed in Effect Studio. Never edited after saving,
/// so a shared link always runs the same recipe.
model CustomEffect {
  id        String   @id @default(cuid())
  name      String
  recipe    Json     // hypereel-effect/1, see src/recipes.ts
  remixOf   String?  // effect id this started from: built-in id or "custom:<id>"
  sessionId String
  ip        String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([ip, createdAt])
}

/// A story: clips in order (the first clip, plus shots added before and after it)
/// and the sound layers that play over all of them.
model Sequence {
  id           String    @id @default(cuid())
  title        String    @default("Untitled story")
  sourceId     String    // the clip the story grew from
  shots        Json      // ordered Generation ids
  audio        Json      @default("[]") // sound layers, see src/services/sequenceAudio.ts
  sessionId    String
  ip           String
  editedAt     DateTime  @default(now()) // last change to shots or sound
  exportStatus String?   // rendering | ready | failed
  exportPath   String?
  exportError  String?
  exportedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([sessionId, createdAt])
}

/// A sound made for a story: AI music, an AI sound effect, or a clip's own audio.
model AudioClip {
  id         String   @id @default(cuid())
  kind       String   // music | sfx | original
  shotId     String?  // for "original": the clip it came from, so its layer can move with that clip
  prompt     String?
  label      String
  seconds    Float
  status     String   @default("queued") // queued | running | succeeded | failed
  path       String?
  error      String?
  comfyJobId String?
  sessionId  String
  ip         String
  createdAt  DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}

/// A free board of assets and videos. Card positions live in `board`; what the cards
/// show lives in Asset and Generation rows.
model Canvas {
  id        String   @id @default(cuid())
  title     String   @default("Untitled canvas")
  board     Json     // { cards: [{ id, kind, refId, x, y }], viewport: { x, y, zoom } }
  sessionId String
  ip        String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId, updatedAt])
}

/// An image, a character (one or more photos) or a character sheet on a canvas.
model Asset {
  id         String   @id @default(cuid())
  canvasId   String
  kind       String   // image | character | sheet
  name       String
  status     String   @default("queued") // queued | running | succeeded | failed
  paths      Json     @default("[]") // stored image keys
  prompt     String?
  sources    Json     @default("[]") // asset ids it was made from
  generated  Boolean  @default(false) // made by a model, so it counts against the caps
  error      String?
  comfyJobId String?
  sessionId  String
  ip         String
  createdAt  DateTime @default(now())

  @@index([canvasId, createdAt])
  @@index([sessionId, createdAt])
  @@index([ip, createdAt])
  @@index([createdAt])
}
