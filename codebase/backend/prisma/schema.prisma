// Prisma schema: the single source of truth for the database shape.
// Every change here becomes a versioned SQL migration in prisma/migrations
// (`npm run migrate:dev -- --name <what-changed>`), which is what runs in prod.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenerationStatus {
  queued
  running
  succeeded
  failed
}

// One row per "Hypereel" request. The uploaded photo and the resulting
// video live in object storage (local volume for now); the DB only keeps paths.
model Generation {
  id          String           @id @default(cuid())
  status      GenerationStatus @default(queued)
  genre       String
  /// Name of a custom effect at render time (built-in names come from effects.ts)
  effectName  String?
  caption     String?
  prompt      String
  /// Scene written by the script-writer LLM node (null for static-template clips)
  script      String?
  /// Uploaded references in the order sent to the model: [{ role, path }]
  references  Json?
  resolution  String?
  aspectRatio String?
  model       String           // which H3 variant produced it, for the credits math
  comfyJobId  String?
  progress    Int              @default(0)   // 0-100, best effort from Comfy events
  inputPath   String                         // uploaded (resized) photo
  videoPath   String?
  posterPath  String?
  error       String?
  sessionId   String                         // anonymous cookie session
  ip          String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([sessionId, createdAt])
  @@index([ip, createdAt])
  @@index([status, createdAt])
}

/// An effect someone wrote or remixed in Effect Studio. Never edited after saving,
/// so a shared link always runs the same recipe.
model CustomEffect {
  id        String   @id @default(cuid())
  name      String
  recipe    Json     // hypereel-effect/1, see src/recipes.ts
  remixOf   String?  // effect id this started from: built-in id or "custom:<id>"
  sessionId String
  ip        String
  createdAt DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([ip, createdAt])
}
