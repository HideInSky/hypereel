# Dev image used by docker-compose: Vite dev server with HMR, source bind-mounted.
FROM node:22-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
COPY codebase/backend/package.json codebase/backend/
COPY codebase/frontend/package.json codebase/frontend/
RUN npm ci
WORKDIR /app/codebase/frontend
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
