# ---- Backend (codebase/backend) ----
# Postgres connection. Local dev: `npm run db:local -w codebase/backend` starts an embedded one on :54329.
# docker compose: postgresql://postgres:postgres@postgres:5432/hypereel
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/hypereel
PORT=3000
# Absolute public URL of the deployed app (share links + OG tags are built from it)
PUBLIC_URL=http://localhost:3000
# Random string, >=16 chars. Signs the anonymous session cookie.
COOKIE_SECRET=change-me-to-a-long-random-string
# Where uploads/videos are written (mount a volume here in prod)
DATA_DIR=./data

# ---- Comfy Cloud / MiniMax H3 ----
# workflow = run workflows/hypereel_h3_i2v_api.json on Comfy Cloud (default in prod)
# fake     = offline stub, no credits spent (default in dev)
COMFY_MODE=fake
# From https://platform.comfy.org -> API Keys (paid Comfy Cloud plan required)
COMFY_API_KEY=

# ---- Credit protection (each clip costs ~38 credits ≈ $0.18 at 480P Turbo) ----
LIMIT_PER_SESSION_PER_HOUR=3
LIMIT_PER_IP_PER_DAY=10
LIMIT_GLOBAL_PER_DAY=25
MAX_UPLOAD_MB=10

# ---- docker compose only ----
POSTGRES_PASSWORD=postgres
# Cloudflare Tunnel token (optional; `docker compose --profile tunnel up`)
CLOUDFLARE_TUNNEL_TOKEN=
